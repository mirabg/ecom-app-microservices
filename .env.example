# Copy to .env and adjust for your environment:  cp .env.example .env
# .env is git-ignored and must never be committed.
#
# These defaults match the service definitions in docker-compose.yml.

# --- Postgres (consumed by docker-compose.yml) ---
POSTGRES_USER=root
POSTGRES_PASSWORD=root

# --- Postgres (consumed by order-service / product-service via config-server) ---
DB_USER=root
DB_PASSWORD=root

# --- RabbitMQ (consumed by docker-compose.yml) ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# --- RabbitMQ (consumed by the Spring Cloud Bus clients) ---
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672

# --- Optional: override the Zipkin collector endpoint ---
# Defaults to http://localhost:9411/api/v2/spans when unset.
# ZIPKIN_TRACING_ENDPOINT=http://localhost:9411/api/v2/spans

