# Copy to .env and adjust for your environment:  cp .env.example .env
# .env is git-ignored and must never be committed.
#
# Every value below is OPTIONAL - docker-compose.yml supplies the same defaults
# inline (${VAR:-default}), so `docker compose up` works with no .env at all.
# Override only what you need to change.
#
# NOTE: these are read by DOCKER COMPOSE, not by the Spring apps directly.
# Compose injects them into the containers as environment variables, which then
# resolve the ${...} placeholders in the config-server yaml files. Running a
# service from the IDE ignores this file entirely - see README.md.

# --- Postgres ---
# Single source of truth: used both to initialise the postgres container and by
# product-service / order-service / keycloak to connect to it. Changing these
# after the volume has been created has no effect on the existing database -
# you must `docker compose down -v` to re-initialise.
DB_USER=root
DB_PASSWORD=root

# --- MongoDB (user-service) ---
MONGO_USER=root
MONGO_PASSWORD=root

# --- RabbitMQ ---
# Used for the broker's default account and by every Spring Cloud Bus client.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Hibernate schema management (product-service, order-service) ---
# `update` keeps existing rows and adds missing tables/columns.
# `create` drops and recreates the schema on EVERY start - data loss on restart.
JPA_DDL_AUTO=update

# --- Keycloak ---
# The realm, client and service-account roles are provisioned automatically
# from keycloak/realm-export/ecom-app-realm.json. If you change the client
# secret here you must change it in that file too, or user-service cannot
# authenticate against the Admin API.
KEYCLOAK_REALM=ecom-app
KEYCLOAK_ADMIN_CLIENT_ID=user-service-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=2iaX0dpf1zkXq7k7fLKHj9Yjg2rOs41L

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=pgadmin4@pgadmin.org
PGADMIN_DEFAULT_PASSWORD=admin
